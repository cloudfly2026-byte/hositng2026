datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id            String         @id
  email         String         @unique
  fullName      String
  emailVerified Boolean        @default(false)
  passwordHash  String?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  memberships   Membership[]
  organizations Organization[] @relation("OrgOwner")

  @@map("users")
}

model Organization {
  id              String                @id
  name            String
  slug            String                @unique
  ownerUserId     String
  isInternalPilot Boolean               @default(false)
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt
  owner           User                  @relation("OrgOwner", fields: [ownerUserId], references: [id], onDelete: Cascade)
  memberships     Membership[]
  orders          Order[]
  entitlements    CustomerEntitlement[]
  projects        Project[]
  services        Service[]
  cartDrafts      CartDraft[]
  subscriptions   Subscription[]
  invoices        Invoice[]
  auditEvents     AuditEvent[]

  @@map("organizations")
}

model Membership {
  id               String       @id
  userId           String
  organizationId   String
  role             String
  linkedHestiaUser String?
  createdAt        DateTime     @default(now())
  user             User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization     Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([userId, organizationId])
  @@index([organizationId])
  @@index([userId])
  @@map("memberships")
}

model Product {
  id        String   @id
  name      String
  code      String   @unique
  category  String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  plans     Plan[]

  @@map("products")
}

model Plan {
  id                 String        @id
  productId          String
  name               String
  code               String        @unique
  infrastructureMode String
  createdAt          DateTime      @default(now())
  product            Product       @relation(fields: [productId], references: [id], onDelete: Cascade)
  versions           PlanVersion[]

  @@index([productId])
  @@map("plans")
}

model PlanVersion {
  id        String      @id
  planId    String
  version   Int
  quotas    Json
  prices    Json
  createdAt DateTime    @default(now())
  plan          Plan           @relation(fields: [planId], references: [id], onDelete: Cascade)
  items         OrderItem[]
  subscriptions Subscription[]

  @@unique([planId, version])
  @@index([planId])
  @@map("plan_versions")
}

model Order {
  id             String                @id
  organizationId String
  orderNumber    String                @unique
  status         String
  currency       String
  subtotalCents  Int
  taxCents       Int
  totalCents     Int
  idempotencyKey String                @unique
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt
  organization   Organization          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  items          OrderItem[]
  entitlements   CustomerEntitlement[]
  payments       Payment[]
  invoices       Invoice[]

  @@index([organizationId, status])
  @@index([organizationId])
  @@map("orders")
}

model OrderItem {
  id             String      @id
  orderId        String
  planVersionId  String
  billingCycle   String
  unitPriceCents Int
  quantity       Int
  order          Order       @relation(fields: [orderId], references: [id], onDelete: Cascade)
  planVersion    PlanVersion @relation(fields: [planVersionId], references: [id], onDelete: Restrict)

  @@index([orderId])
  @@index([planVersionId])
  @@map("order_items")
}

model CustomerEntitlement {
  id             String       @id
  organizationId String
  orderId        String
  planVersionId  String
  status         String
  quotas         Json
  validUntil     DateTime
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  order          Order        @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([organizationId, status])
  @@index([organizationId])
  @@index([orderId])
  @@map("customer_entitlements")
}

model Project {
  id                 String       @id
  organizationId     String
  name               String
  slug               String
  infrastructureMode String
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt
  organization       Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  services           Service[]

  @@unique([organizationId, slug])
  @@index([organizationId])
  @@map("projects")
}

model Service {
  id                String       @id
  projectId         String
  organizationId    String
  name              String
  slug              String
  runtimeTemplateId String
  desiredState      Json
  observedState     Json
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt
  project           Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  organization      Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([projectId, slug])
  @@index([projectId])
  @@index([organizationId])
  @@map("services")
}

model CartDraft {
  id                 String       @id
  anonymousTokenHash String
  userId             String?
  organizationId     String?
  currency           String
  items              Json
  subtotalCents      Int
  taxCents           Int
  totalCents         Int
  expiresAt          DateTime
  status             String
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt
  organization       Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)

  @@index([anonymousTokenHash])
  @@index([organizationId])
  @@index([status])
  @@map("cart_drafts")
}

model Payment {
  id                    String   @id
  orderId               String
  provider              String
  providerTransactionId String?
  status                String
  amountCents           Int
  currency              String
  signatureVerified     Boolean  @default(false)
  rawPayload            Json?
  createdAt             DateTime @default(now())
  order                 Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@index([provider, providerTransactionId])
  @@index([status])
  @@map("payments")
}

model Subscription {
  id                 String       @id
  organizationId     String
  planVersionId      String
  orderId            String
  status             String
  billingCycle       String
  currentPeriodStart DateTime
  currentPeriodEnd   DateTime
  gracePeriodUntil   DateTime?
  suspendedAt        DateTime?
  cancelledAt        DateTime?
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt
  organization       Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  planVersion        PlanVersion  @relation(fields: [planVersionId], references: [id], onDelete: Restrict)

  @@index([organizationId, status])
  @@index([planVersionId])
  @@map("subscriptions")
}

model Invoice {
  id             String       @id
  invoiceNumber  String       @unique
  organizationId String
  orderId        String
  subscriptionId String?
  status         String
  currency       String
  subtotalCents  Int
  taxCents       Int
  totalCents     Int
  items          Json
  issuedAt       DateTime     @default(now())
  dueDate        DateTime
  paidAt         DateTime?
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  order          Order        @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([orderId])
  @@index([status])
  @@map("invoices")
}

model AuditEvent {
  id             String        @id
  organizationId String?
  actorUserId    String?
  action         String
  resource       String
  metadata       Json?
  createdAt      DateTime      @default(now())
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)

  @@index([organizationId])
  @@index([actorUserId])
  @@index([action])
  @@map("audit_events")
}

